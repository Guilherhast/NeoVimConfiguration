{
	"suggest.noselect": true,
	"suggest.enablePreselect": false,
	"suggest.removeDuplicateItems": true,
	"suggest.triggerAfterInsertEnter": true,
	"suggest.enableFloat": false,
	"signature.preferShownAbove": false,
	"signature.hideOnTextChange": true,
	"snippets.ultisnips.pythonPrompt": false,
	"snippets.priority": 0,
	"prettier.useTabs": true,
	"prettier.enable": false,
	"prettier.bracketSpacing": false,
	"prettier.singleQuote": true,
	"diagnostic.errorSign": "x",
	"diagnostic.warningSign": "!",
	"diagnostic.hintSign": "#",
	"diagnostic.infoSign": "@",
	"hover.autoHide": true,
	"css.lint.unknownAtRules": "ignore",
	"Lua.runtime.version": "LuaJIT",
	"Lua.diagnostics.globals": [
		"vim", "os", "turtle", "redstone", "peripheral", "shell"
	],
	"Lua.diagnostics.disable": [
		"lowercase-global"
	],
	"Lua.window.progressBar": false,
	"Lua.workspace.library": [
		"~/.config/nvim/libs/lua/lua-ls-cc-tweaked/library",
	],
	"Lua.runtime.pathStrict": false,
	"Lua.workspace.ignoreSubmodules": false,
	"Lua.workspace.checkThirdParty": false,
	"inlayHint.enable": false,
	"python.analysis.extraPaths":[
		"~/.config/nvim/libs/python/",
	],
	"python.analysis.stubPath": "~/.config/nvim/libs/python",
	"pyright.inlayHints.functionReturnTypes": false,
	"pyright.inlayHints.variableTypes": false,
	"sumneko-lua.enableNvimLuaDev": true,
	"emmet.preferences": {
		"output.quoteStyle": "single",
		"attributeQuotes": "single",
	},
	"emmet.syntaxProfiles": {
		"html": { "attr_quotes": "single"}
	},
	"emmet.includeLanguages": {
		"html": "html",
		"javascriptreact": "html",
		"typescriptreact": "html",
		"javascript": "javascriptreact",
	},
	"intelephense.format.braces": "k&r",
	"javascript.format.insertSpaceAfterOpeningAndBeforeClosingNonemptyBrackets": false,
	"typescript.format.insertSpaceAfterFunctionKeywordForAnonymousFunctions": false,
	"javascript.format.insertSpaceAfterFunctionKeywordForAnonymousFunctions": false,
	"intelephense.diagnostics.undefinedFunctions": false,
	"intelephense.diagnostics.undefinedConstants": false,
	"intelephense.diagnostics.undefinedTypes": false,
	"intelephense.environment.includePaths": [
		"~/.config/nvim/libs/php/vendor/php-stubs/wordpress-stubs",
		"~/.config/nvim/libs/php/vendor/php-stubs/wp-cli-stubs"
	],
	"tailwindCSS.headwind.runOnSave": false,
}
